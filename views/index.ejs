<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Toy Shop</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f8f8f8;
      color: #333;
    }

    /* Navbar */
    nav {
      height: 70px;
      background: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 60px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    .menu {
      display: flex;
      gap: 30px;
    }

    .menu a {
      text-decoration: none;
      color: #333;
      font-weight: bold;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 100px 20px;
      background: #ffe8f0;
    }

    .hero h1 {
      font-size: 48px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 20px;
    }

    /* Products */
    .products {
      padding: 60px;
      text-align: center;
    }

    .products h2 {
      font-size: 32px;
      margin-bottom: 30px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      max-width: 1000px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .price {
      font-size: 20px;
      font-weight: bold;
      margin: 15px 0;
    }

    .button {
      display: inline-block;
      padding: 10px 20px;
      background: #333;
      color: white;
      text-decoration: none;
      border-radius: 6px;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 30px;
      background: #333;
      color: white;
      margin-top: 50px;
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav>
    <div class="logo">
      🧸 Toy Shop
    </div>

    <div class="menu">
      <a href="/">Home</a>
      <a href="/products/page">Products</a>
      <a href="/auth/login">Login</a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <h1>Welcome to Toy Shop</h1>
    <p>Find your favorite toys!</p>
  </section>

  <!-- Products -->
  <section class="products">
    <h2>Featured Products</h2>

    <div class="product-grid">

      <div class="card">
        <h3>🧸 Teddy Bear</h3>
        <p>ตุ๊กตาหมีน่ารัก</p>
        <div class="price">299 บาท</div>
        <a href="/products/page" class="button">
          ดูสินค้า
        </a>
      </div>

      <div class="card">
        <h3>🚗 Toy Car</h3>
        <p>รถของเล่น</p>
        <div class="price">199 บาท</div>
        <a href="/products/page" class="button">
          ดูสินค้า
        </a>
      </div>

      <div class="card">
        <h3>🧸 Doll</h3>
        <p>ตุ๊กตาน่ารัก</p>
        <div class="price">399 บาท</div>
        <a href="/products/page" class="button">
          ดูสินค้า
        </a>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer>
    © 2026 Toy Shop
  </footer>

</body>
</html>