<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Cart | Toy Shop</title>
  <link rel="stylesheet" href="/css/cart.css">
</head>

<body>

  <nav class="navbar">
    <a href="/products/page" class="logo">Toy Shop</a>

    <div class="nav-user">
      Welcome, <strong><%= username %></strong>
    </div>
  </nav>

  <main class="container">

    <div class="page-header">
      <div>
        <h1>My Cart</h1>
        <p>Review your selected products before checkout.</p>
      </div>

      <a href="/products/page" class="continue-link">
        ← Continue Shopping
      </a>
    </div>

    <% if (items.length === 0) { %>

      <section class="empty-cart">
        <div class="empty-icon">🛒</div>
        <h2>Your cart is empty</h2>
        <p>You haven't added any products to your cart yet.</p>

        <a href="/products/page" class="primary-btn">
          Browse Products
        </a>
      </section>

    <% } else { %>

      <!-- Empty form used by selected-item checkboxes -->
      <form action="/orders/checkout" method="GET" id="checkoutForm"></form>

      <div class="cart-layout">

        <section class="cart-section">

          <div class="section-heading">
            <h2>Shopping Cart</h2>
            <span><%= items.length %> item<%= items.length !== 1 ? 's' : '' %></span>
          </div>

          <div class="cart-items">

            <% items.forEach(item => { %>

              <article class="cart-item">

                <div class="item-main">

                  <input
                    class="item-checkbox"
                    type="checkbox"
                    name="cartItemIds"
                    value="<%= item.id %>"
                    form="checkoutForm"
                  >

                  <div class="product-image">
                    🧸
                  </div>

                  <div class="product-info">
                    <h3>Toy Product</h3>

                    <p class="product-id">
                      Product ID: <%= item.productId %>
                    </p>

                    <p class="quantity-text">
                      Quantity: <strong><%= item.quantity %></strong>
                    </p>
                  </div>

                </div>

                <div class="item-actions">

                  <form
                    action="/cart/<%= item.id %>/edit"
                    method="POST"
                    class="update-form"
                  >
                    <label for="quantity-<%= item.id %>">
                      Quantity
                    </label>

                    <input
                      id="quantity-<%= item.id %>"
                      class="quantity-input"
                      type="number"
                      name="quantity"
                      value="<%= item.quantity %>"
                      min="1"
                    >

                    <button type="submit" class="secondary-btn">
                      Update
                    </button>
                  </form>

                  <form
                    action="/cart/<%= item.id %>/delete"
                    method="POST"
                  >
                    <button type="submit" class="remove-btn">
                      Remove
                    </button>
                  </form>

                </div>

              </article>

            <% }) %>

          </div>

        </section>

        <aside class="summary-card">

          <h2>Order Summary</h2>

          <div class="summary-row">
            <span>Cart Items</span>
            <strong><%= items.length %></strong>
          </div>

          <div class="summary-row">
            <span>Selected Items</span>
            <strong>Choose above</strong>
          </div>

          <div class="summary-divider"></div>

          <div class="summary-total">
            <span>Total</span>
            <strong>Calculated at checkout</strong>
          </div>

          <button
            type="submit"
            form="checkoutForm"
            class="checkout-btn"
          >
            Checkout Selected
          </button>

          <p class="summary-note">
            Select the products you want to purchase.
          </p>

        </aside>

      </div>

    <% } %>

  </main>

</body>
</html>
