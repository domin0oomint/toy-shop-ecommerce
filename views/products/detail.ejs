<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Detail - Toy Shop</title>

    <link rel="stylesheet" href="/css/products.css">
</head>

<body>
    <nav class="navbar">
        <div class="logo">
            🧸 Toy Shop

        </div>
        <div class="menu">
            <a href="/">Home</a>
            <a href="/products/page">Products</a>
            <a href="/cart">Cart</a>
    </nav>
    <main class="container">
        <div class="product-image">
            🧸
        </div class="product=info">
        <h1>
            <%= product.name %><!--คำอธิบายสินค้า" จากฐานข้อมูลมาแสดงผลบนหน้าเว็บไซต์ -->
        </h1>
        <p class="description">
            <%= product.description %>
        </p>
        <p class="price">
            $<%= product.price %>
        </p>
        <p class="stock">
            Stock: <%= product.stock %>
        </p>
        <% if (role==='buyer' ) { %>
            <form action="/cart/add/<%= product.id %>" method="POST">
                <input type="hidden" name="productId" value="<%= product.id %>">
                  %>">
                <button type="submit">Add to Cart</button>
            </form>
            <br><br>
            <a href="/products/page">Back to Products</a>
            <% } %>
    </main>
    <footer>
        <p>© 2026 Toy Shop</p>
    </footer>
</body>

</html>